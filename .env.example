# Copy to .env. NEVER COMMIT .env OR REAL CREDENTIALS.
MODEL_API_KEY=replace-with-your-meta-model-api-key

# Local-only storage limit: 100 MiB. SAM inference retains a separate 25 MiB guard.
VIDEO_MAX_BYTES=104857600
# Leave at 0 for sequential concept calls; 1 is opt-in parallel inference.
SAM_CONCURRENT_CONCEPTS=0

# Optional structured persistence. Use a dedicated Neon database.
# Keep real DATABASE_URL only in the untracked .env file / Render secrets.
VISIONGUARD_USE_DATABASE=0
# DATABASE_URL=postgresql://ROLE:PASSWORD@HOST/DB?sslmode=require
